{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Blockchain Operations & Latency",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Blockchain Transaction Rate by Method",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(blockchain_transaction_total[1m])) by (method, status)",
          "legendFormat": "{{method}} ({{status}})"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Blockchain Transaction Latency (P95 / P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(blockchain_transaction_duration_ms_bucket[5m])) by (le, method))",
          "legendFormat": "P95 {{method}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(blockchain_transaction_duration_ms_bucket[5m])) by (le, method))",
          "legendFormat": "P99 {{method}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "bars" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Blockchain Errors by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(blockchain_transaction_errors_total[5m])) by (method, error_type)",
          "legendFormat": "{{method}} - {{error_type}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Cache Performance & Hit Ratios",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 85 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "id": 4,
      "title": "Cache Hit Ratio (5m)",
      "type": "gauge",
      "targets": [
        {
          "expr": "(sum(rate(cache_hit_total[5m])) / (sum(rate(cache_hit_total[5m])) + sum(rate(cache_miss_total[5m])))) * 100",
          "legendFormat": "Hit Ratio"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 10 },
      "id": 5,
      "title": "Cache Hits vs Misses Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(cache_hit_total[1m])) by (key_prefix)",
          "legendFormat": "Hits ({{key_prefix}})"
        },
        {
          "expr": "sum(rate(cache_miss_total[1m])) by (key_prefix)",
          "legendFormat": "Misses ({{key_prefix}})"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 10 },
      "id": 6,
      "title": "Cache Operation Latency (P95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cache_operation_duration_ms_bucket[5m])) by (le, operation))",
          "legendFormat": "P95 {{operation}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Database Health & Connection Pool",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 7,
      "title": "Database Connection Pool Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "database_connection_pool_size",
          "legendFormat": "Total Pool Size"
        },
        {
          "expr": "available_connections",
          "legendFormat": "Available (Idle)"
        },
        {
          "expr": "database_connection_pool_size - available_connections",
          "legendFormat": "Active (Busy)"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 8,
      "title": "Database Query Latency by Type (P95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(database_query_duration_ms_bucket[5m])) by (le, query_type))",
          "legendFormat": "{{query_type}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 9,
      "title": "Database Transaction Duration (P95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(database_transaction_duration_ms_bucket[5m])) by (le, transaction_name))",
          "legendFormat": "{{transaction_name}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["proofstell", "blockchain", "cache", "database", "slo"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "ProofStell System & Infrastructure Metrics",
  "uid": "proofstell-core-metrics",
  "version": 1
}
